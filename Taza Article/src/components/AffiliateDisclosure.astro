---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`rounded-lg border border-zinc-200/80 bg-zinc-50/60 p-3 text-xs text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400 ${className}`}>
  <div class="flex items-start gap-2">
    <span class="text-sm leading-none">💡</span>
    <p class="leading-relaxed">
      <strong class="font-medium text-zinc-800 dark:text-zinc-200">Affiliate Disclosure:</strong> 
      Taza Article is reader-supported. We may earn a small referral commission if you sign up through links on our site at zero extra cost to you. We only recommend genuine developer tools and student perks tested by our team. 
      <a href="/affiliate-disclosure" class="font-medium text-emerald-700 underline hover:text-emerald-800 dark:text-emerald-400 ml-0.5">
        Learn more
      </a>.
    </p>
  </div>
</div>
