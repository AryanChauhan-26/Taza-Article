---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with the editorial team at Taza Article for inquiries, tool suggestions, or corrections."
>
  <div class="mx-auto max-w-2xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
        📬 Get in Touch
      </span>
      <h1 class="mt-3 text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Contact the Taza Article Team
      </h1>
      <p class="mt-1.5 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        Have feedback, noticed an expired deal, or want to suggest a new tool for CS students? We'd love to hear from you.
      </p>
    </div>

    <div class="mt-8 rounded-xl border border-zinc-200/80 bg-white p-6 sm:p-8 shadow-2xs dark:border-zinc-800 dark:bg-zinc-900">
      
      <div class="flex items-center gap-3.5 border-b border-zinc-100 pb-5 dark:border-zinc-800">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h2 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
            Direct Editorial Email
          </h2>
          <a
            href={`mailto:${siteConfig.contactEmail}`}
            class="text-sm font-semibold text-emerald-700 hover:underline dark:text-emerald-400"
          >
            {siteConfig.contactEmail}
          </a>
        </div>
      </div>

      <!-- Quick Message Form -->
      <form id="contact-form" class="mt-5 space-y-4">
        <div>
          <label for="contact-name" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300">
            Your Full Name
          </label>
          <input
            type="text"
            id="contact-name"
            required
            placeholder="Aryan Sharma"
            class="mt-1 w-full rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-xs sm:text-sm text-zinc-900 shadow-2xs transition-colors duration-150 focus:border-zinc-400 focus:outline-none dark:border-zinc-800 dark:bg-zinc-850 dark:text-white"
          />
        </div>

        <div>
          <label for="contact-email" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300">
            Your College or Personal Email
          </label>
          <input
            type="email"
            id="contact-email"
            required
            placeholder="student@college.ac.in"
            class="mt-1 w-full rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-xs sm:text-sm text-zinc-900 shadow-2xs transition-colors duration-150 focus:border-zinc-400 focus:outline-none dark:border-zinc-800 dark:bg-zinc-850 dark:text-white"
          />
        </div>

        <div>
          <label for="contact-subject" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300">
            Subject
          </label>
          <input
            type="text"
            id="contact-subject"
            required
            placeholder="Tool suggestion / Question / Correction"
            class="mt-1 w-full rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-xs sm:text-sm text-zinc-900 shadow-2xs transition-colors duration-150 focus:border-zinc-400 focus:outline-none dark:border-zinc-800 dark:bg-zinc-850 dark:text-white"
          />
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-medium text-zinc-700 dark:text-zinc-300">
            Your Message
          </label>
          <textarea
            id="contact-message"
            rows="3"
            required
            placeholder="Tell us what's on your mind..."
            class="mt-1 w-full rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-xs sm:text-sm text-zinc-900 shadow-2xs transition-colors duration-150 focus:border-zinc-400 focus:outline-none dark:border-zinc-800 dark:bg-zinc-850 dark:text-white"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-emerald-700 px-5 py-2.5 text-xs font-semibold text-white shadow-2xs transition-colors duration-150 hover:bg-emerald-800 focus:outline-none dark:bg-emerald-600 dark:hover:bg-emerald-500"
        >
          Send Message →
        </button>
      </form>

      <div id="contact-success" class="mt-4 hidden rounded-lg bg-emerald-50 p-3 text-center text-xs font-medium text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
        ✅ Thank you for your note! We usually respond within 24 to 48 hours.
      </div>

    </div>

    <!-- Response SLA Note -->
    <div class="mt-6 text-center text-xs text-zinc-400">
      ⚡ We strive to respond to all inquiries within 24–48 hours.
    </div>

  </div>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contact-form');
  const successBox = document.getElementById('contact-success');
  if (contactForm && successBox) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactForm.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>
