---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`relative overflow-hidden rounded-2xl border border-zinc-200/80 bg-zinc-900 p-7 sm:p-9 text-white shadow-2xs dark:border-zinc-800 dark:bg-zinc-900 ${className}`}>
  
  <div class="relative z-10 mx-auto max-w-xl text-center">
    <div class="inline-flex items-center gap-1.5 rounded-md bg-zinc-800 px-2.5 py-1 text-xs font-medium text-emerald-400">
      <span>✉️</span>
      <span>Weekly newsletter</span>
    </div>

    <h2 class="mt-3 text-xl font-bold tracking-tight sm:text-2xl text-white">
      Get fresh articles, every week
    </h2>
    <p class="mt-2 text-xs sm:text-sm text-zinc-400 leading-relaxed">
      Free cloud database tiers, student pack credits, and project resources delivered straight to your inbox. No spam, ever.
    </p>

    <form id="newsletter-form" class="mt-6 flex flex-col items-center justify-center gap-2 sm:flex-row">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        type="email"
        id="newsletter-email"
        required
        placeholder="Enter your email address..."
        class="w-full rounded-lg border border-zinc-700 bg-zinc-800/90 px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-zinc-500 transition-colors duration-150 focus:border-emerald-500 focus:bg-zinc-800 focus:outline-none focus:ring-1 focus:ring-emerald-500 sm:max-w-xs"
      />
      <button
        type="submit"
        class="w-full shrink-0 rounded-lg bg-emerald-600 px-4.5 py-2.5 text-xs sm:text-sm font-semibold text-white shadow-2xs transition-colors duration-150 hover:bg-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-400 sm:w-auto"
      >
        Subscribe Free →
      </button>
    </form>

    <div id="newsletter-success" class="mt-4 hidden rounded-lg bg-emerald-950/70 border border-emerald-800 p-3 text-xs font-medium text-emerald-200">
      🎉 You're subscribed! Keep an eye on your inbox for our next drop.
    </div>

    <p class="mt-3 text-[11px] text-zinc-500">
      100% free • No spam • One email every Saturday • Unsubscribe anytime
    </p>
  </div>
</div>

<script>
  const form = document.getElementById('newsletter-form');
  const successBox = document.getElementById('newsletter-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('newsletter-email') as HTMLInputElement;
      if (emailInput && emailInput.value) {
        try {
          const subscribers = JSON.parse(localStorage.getItem('taza_subscribers') || '[]');
          subscribers.push({ email: emailInput.value, date: new Date().toISOString() });
          localStorage.setItem('taza_subscribers', JSON.stringify(subscribers));
        } catch (_) {}
      }
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>
