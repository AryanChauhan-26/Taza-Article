---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdBanner from '../../components/AdBanner.astro';
import { siteConfig } from '../../config/site';
import { getCollection } from 'astro:content';
import { getCategorySlug } from '../../utils/slugify';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id }) => !id.startsWith('_'));
  
  // Collect all unique categories from config and posts
  const categoryMap = new Map();
  siteConfig.categories.forEach((cat) => {
    categoryMap.set(cat.slug, {
      slug: cat.slug,
      name: cat.name,
      description: cat.description,
      icon: cat.icon,
    });
  });

  posts.forEach((post) => {
    const slug = getCategorySlug(post.data.category);
    if (!categoryMap.has(slug)) {
      categoryMap.set(slug, {
        slug,
        name: post.data.category,
        description: `Explore all articles, guides, and tools related to ${post.data.category}.`,
        icon: '📁',
      });
    }
  });

  return Array.from(categoryMap.values()).map((category) => {
    const matchingPosts = posts.filter(
      (p) => getCategorySlug(p.data.category) === category.slug
    );
    return {
      params: { category: category.slug },
      props: {
        category,
        posts: matchingPosts.sort(
          (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
        ),
      },
    };
  });
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={`${category.name} Resources & Articles`}
  description={category.description}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    
    <!-- Category Header Card -->
    <div class="rounded-2xl border border-zinc-200/80 bg-white p-7 sm:p-9 shadow-2xs dark:border-zinc-800 dark:bg-zinc-900">
      <div class="flex items-center gap-3">
        <span class="text-3xl sm:text-4xl">{category.icon}</span>
        <div>
          <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
            Category Archive
          </span>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            {category.name}
          </h1>
        </div>
      </div>

      <p class="mt-3 max-w-2xl text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        {category.description}
      </p>

      <div class="mt-4 flex items-center gap-2 text-xs text-zinc-400">
        <span class="rounded bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
          {posts.length} {posts.length === 1 ? 'Article' : 'Articles'}
        </span>
        <span>• Updated weekly</span>
      </div>
    </div>

    <!-- Reserved Ad Banner -->
    <AdBanner slotType="below-title" className="my-8" />

    <!-- Articles List / Grid -->
    <div class="mt-8">
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              pubDate={new Date(post.data.pubDate)}
              category={post.data.category}
              tags={post.data.tags}
              slug={post.id.replace(/\.(md|mdx)$/, '')}
              rawContent={post.body}
            />
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-gray-300 p-12 text-center dark:border-gray-800">
          <p class="text-base font-semibold text-gray-700 dark:text-gray-300">
            Fresh articles in this category are coming this week!
          </p>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
            We are curating and testing new developer tools. Check back shortly.
          </p>
          <a
            href="/"
            class="mt-5 inline-flex items-center rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-semibold text-white shadow hover:bg-emerald-700 transition"
          >
            ← Back to Home
          </a>
        </div>
      )}
    </div>

  </div>
</BaseLayout>
