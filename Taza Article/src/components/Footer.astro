---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-zinc-200/70 bg-white/60 transition-colors duration-200 dark:border-zinc-800/70 dark:bg-zinc-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      
      <!-- Column 1: Brand & Mission -->
      <div class="space-y-2.5 md:col-span-2">
        <div class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-emerald-600 text-white font-bold text-xs dark:bg-emerald-500">
            T
          </div>
          <span class="text-base font-bold text-zinc-900 dark:text-zinc-100">
            Taza<span class="text-emerald-600 dark:text-emerald-400">Article</span>
          </span>
        </div>
        <p class="text-xs font-medium text-emerald-700 dark:text-emerald-400">
          Fresh articles, every week
        </p>
        <p class="max-w-md text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">
          Curated free developer tools, zero-cost cloud databases, student pack hacks, and project blueprints built specifically for CS & B.Tech engineering students in India.
        </p>
        <div class="pt-1 text-[11px] text-zinc-400 dark:text-zinc-500">
          🌱 Zero bloated databases • 100% static & blazingly fast
        </div>
      </div>

      <!-- Column 2: Explore Categories -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">
          Categories
        </h4>
        <ul class="mt-3 space-y-2 text-xs">
          {siteConfig.categories.map((cat) => (
            <li>
              <a
                href={`/category/${cat.slug}`}
                class="text-zinc-500 hover:text-emerald-700 transition-colors dark:text-zinc-400 dark:hover:text-emerald-400"
              >
                {cat.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href="/categories"
              class="font-medium text-emerald-700 hover:underline dark:text-emerald-400"
            >
              Browse all categories →
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Trust & Legal -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-100">
          Trust & Legal
        </h4>
        <ul class="mt-3 space-y-2 text-xs">
          <li>
            <a href="/about" class="text-zinc-500 hover:text-emerald-700 transition-colors dark:text-zinc-400 dark:hover:text-emerald-400">
              About Taza Article
            </a>
          </li>
          <li>
            <a href="/contact" class="text-zinc-500 hover:text-emerald-700 transition-colors dark:text-zinc-400 dark:hover:text-emerald-400">
              Contact Editorial Team
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-zinc-500 hover:text-emerald-700 transition-colors dark:text-zinc-400 dark:hover:text-emerald-400">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="text-zinc-500 hover:text-emerald-700 transition-colors dark:text-zinc-400 dark:hover:text-emerald-400">
              Terms & Conditions
            </a>
          </li>
          <li>
            <a href="/affiliate-disclosure" class="text-zinc-500 hover:text-emerald-700 transition-colors dark:text-zinc-400 dark:hover:text-emerald-400">
              Affiliate Disclosure
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 flex flex-col items-center justify-between border-t border-zinc-200/60 pt-5 text-xs text-zinc-400 dark:border-zinc-850 dark:text-zinc-500 sm:flex-row">
      <p>© {currentYear} {siteConfig.name}. All rights reserved.</p>
      <p class="mt-2 sm:mt-0">
        Engineered with Astro & Tailwind CSS for pure speed.
      </p>
    </div>
  </div>
</footer>
