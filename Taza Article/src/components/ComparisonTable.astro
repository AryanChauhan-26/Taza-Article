---
export interface ComparisonItem {
  name: string;
  freeTier: string;
  bestFor: string;
  studentPerk: string;
  rating: string;
  url?: string;
  isPopular?: boolean;
}

interface Props {
  caption?: string;
  items: ComparisonItem[];
}

const {
  caption = 'Side-by-side comparison of top tools and student plans',
  items = []
} = Astro.props;
---

<div class="my-7 overflow-hidden rounded-xl border border-zinc-200/90 bg-white shadow-2xs dark:border-zinc-800 dark:bg-zinc-900">
  {caption && (
    <div class="border-b border-zinc-100 bg-zinc-50/60 px-4 py-2.5 dark:border-zinc-800 dark:bg-zinc-850/50">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
        📊 {caption}
      </span>
    </div>
  )}

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs text-zinc-600 dark:text-zinc-400">
      <thead class="border-b border-zinc-200 bg-zinc-50/40 text-[11px] font-semibold uppercase tracking-wider text-zinc-700 dark:border-zinc-800 dark:bg-zinc-850/40 dark:text-zinc-300">
        <tr>
          <th scope="col" class="px-4 py-3">Platform</th>
          <th scope="col" class="px-4 py-3">Free Tier</th>
          <th scope="col" class="px-4 py-3">Best For</th>
          <th scope="col" class="px-4 py-3">Student Perk</th>
          <th scope="col" class="px-4 py-3 text-center">Score</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/80">
        {items.map((item) => (
          <tr class={`transition-colors duration-100 hover:bg-zinc-50/70 dark:hover:bg-zinc-850/40 ${item.isPopular ? 'bg-emerald-50/20 dark:bg-emerald-950/10' : ''}`}>
            <td class="whitespace-nowrap px-4 py-3.5 font-semibold text-zinc-900 dark:text-zinc-100">
              <div class="flex items-center gap-1.5">
                <span>{item.name}</span>
                {item.isPopular && (
                  <span class="rounded bg-emerald-100 px-1.5 py-0.2 text-[9px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                    TOP
                  </span>
                )}
              </div>
            </td>
            <td class="px-4 py-3.5 text-zinc-600 dark:text-zinc-400">
              {item.freeTier}
            </td>
            <td class="px-4 py-3.5 text-zinc-600 dark:text-zinc-400">
              {item.bestFor}
            </td>
            <td class="px-4 py-3.5 text-zinc-600 dark:text-zinc-400">
              {item.studentPerk}
            </td>
            <td class="whitespace-nowrap px-4 py-3.5 text-center">
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer sponsored nofollow"
                  class="inline-flex items-center gap-1 rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-800 hover:bg-emerald-700 hover:text-white transition-colors duration-150 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-emerald-600"
                >
                  <span>{item.rating}</span>
                  <span>↗</span>
                </a>
              ) : (
                <span class="font-semibold text-zinc-700 dark:text-zinc-300">
                  {item.rating}
                </span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
