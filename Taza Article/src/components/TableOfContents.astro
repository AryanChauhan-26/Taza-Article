---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
// Only include H2 and H3
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav 
    class="my-5 rounded-xl border border-zinc-200/80 bg-white p-4 shadow-2xs dark:border-zinc-800 dark:bg-zinc-900"
    aria-label="Table of Contents"
  >
    <div class="flex items-center justify-between pb-2.5 border-b border-zinc-100 dark:border-zinc-800">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
        Table of Contents
      </span>
      <span class="text-[10px] text-zinc-400">
        {filteredHeadings.length} sections
      </span>
    </div>

    <ul class="mt-2.5 space-y-1.5 text-xs">
      {filteredHeadings.map((h) => (
        <li class={h.depth === 3 ? 'ml-3' : ''}>
          <a
            href={`#${h.slug}`}
            class={`block text-zinc-600 hover:text-emerald-700 transition-colors duration-150 dark:text-zinc-400 dark:hover:text-emerald-400 ${
              h.depth === 2 ? 'font-medium' : 'text-zinc-500 dark:text-zinc-400'
            }`}
          >
            {h.depth === 2 ? '— ' : '↳ '}
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
