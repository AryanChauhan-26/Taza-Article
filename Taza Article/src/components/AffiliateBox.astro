---
interface Props {
  title: string;
  badge?: string; // e.g., "Editor's Choice", "Best Value", "100% Free"
  rating?: string; // e.g., "4.9 / 5"
  priceNote?: string; // e.g., "Free Student Tier / ₹0"
  description: string;
  pros?: string[];
  cons?: string[];
  affiliateUrl: string;
  buttonText?: string;
  disclosure?: string;
}

const {
  title,
  badge = 'Recommended Tool',
  rating = '4.9/5',
  priceNote = 'Free Tier Available',
  description,
  pros = [],
  cons = [],
  affiliateUrl,
  buttonText = 'Claim Free Access →',
  disclosure = 'We may earn a small referral commission if you sign up through our link at zero extra cost to you.'
} = Astro.props;
---

<div class="my-7 overflow-hidden rounded-xl border border-zinc-200/90 bg-white p-5 sm:p-6 shadow-2xs dark:border-zinc-800 dark:bg-zinc-900">
  <!-- Top Header with Badge & Rating -->
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-100 pb-3 dark:border-zinc-800">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">
        ⭐ {badge}
      </span>
      <span class="text-xs text-zinc-500 dark:text-zinc-400">
        Score: <strong class="text-zinc-900 dark:text-zinc-100 font-semibold">{rating}</strong>
      </span>
    </div>
    <div class="text-xs font-medium text-emerald-700 dark:text-emerald-400">
      {priceNote}
    </div>
  </div>

  <!-- Title & Description -->
  <div class="mt-3.5">
    <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      {title}
    </h3>
    <p class="mt-1.5 text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {description}
    </p>
  </div>

  <!-- Pros & Cons Grid -->
  {(pros.length > 0 || cons.length > 0) && (
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {pros.length > 0 && (
        <div class="rounded-lg bg-emerald-50/50 p-3 dark:bg-emerald-950/20">
          <h4 class="text-[11px] font-semibold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">
            What We Like
          </h4>
          <ul class="mt-1.5 space-y-1 text-xs text-zinc-700 dark:text-zinc-300">
            {pros.map((pro) => (
              <li class="flex items-start gap-1.5">
                <span class="text-emerald-600 dark:text-emerald-400 shrink-0">✓</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {cons.length > 0 && (
        <div class="rounded-lg bg-zinc-100/60 p-3 dark:bg-zinc-800/50">
          <h4 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
            Keep in Mind
          </h4>
          <ul class="mt-1.5 space-y-1 text-xs text-zinc-700 dark:text-zinc-300">
            {cons.map((con) => (
              <li class="flex items-start gap-1.5">
                <span class="text-zinc-400 dark:text-zinc-500 shrink-0">•</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}

  <!-- Action Button -->
  <div class="mt-5 flex flex-col items-center justify-between gap-2.5 sm:flex-row">
    <a
      href={affiliateUrl}
      target="_blank"
      rel="noopener noreferrer sponsored nofollow"
      class="inline-flex w-full items-center justify-center rounded-lg bg-emerald-700 px-4 py-2.5 text-xs font-semibold text-white shadow-2xs transition-colors duration-150 hover:bg-emerald-800 focus:outline-none dark:bg-emerald-600 dark:hover:bg-emerald-500 sm:w-auto"
    >
      <span>{buttonText}</span>
    </a>
    <span class="text-center text-[11px] text-zinc-400 dark:text-zinc-500 sm:text-right">
      🛡️ Verified student offer
    </span>
  </div>

  <!-- Disclosure Note -->
  {disclosure && (
    <p class="mt-3.5 border-t border-zinc-100 pt-2.5 text-[11px] text-zinc-400 dark:border-zinc-800 dark:text-zinc-500">
      <span class="font-medium text-zinc-600 dark:text-zinc-400">Disclosure:</span> {disclosure}
    </p>
  )}
</div>
