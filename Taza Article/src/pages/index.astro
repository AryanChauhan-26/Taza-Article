---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import AdBanner from '../components/AdBanner.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';

// Fetch all blog posts excluding draft templates starting with _
const allPosts = await getCollection('blog', ({ id }) => !id.startsWith('_'));

// Sort posts descending by publication date
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Featured post and standard posts
const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const regularPosts = sortedPosts.filter((p) => p.id !== featuredPost?.id);
---

<BaseLayout
  title="Fresh Developer Tools & Resources for CS Students"
  description="Taza Article delivers fresh, curated developer tools, free cloud database tiers, student perks, and project blueprints for B.Tech & CS students in India every week."
>
  <!-- Hero Section (Clean, Quiet & Smooth) -->
  <section class="border-b border-zinc-200/70 bg-white py-14 dark:border-zinc-800/70 dark:bg-zinc-950 sm:py-18 transition-colors duration-200">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        
        <!-- Fresh Tagline Pill -->
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-50/70 px-3 py-1 text-xs font-medium text-emerald-800 dark:border-emerald-500/20 dark:bg-emerald-950/40 dark:text-emerald-300">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
          <span>Fresh articles, every week</span>
        </div>

        <!-- Main Headline -->
        <h1 class="mt-5 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50 leading-tight">
          Supercharge your CS degree at <span class="text-emerald-700 dark:text-emerald-400 font-bold">zero cost.</span>
        </h1>

        <!-- Subtitle -->
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
          Curated free developer tools, zero-cost cloud databases, student pack perks, and practical project blueprints for engineering students across India.
        </p>

        <!-- Search & Action shortcut -->
        <div class="mt-7 flex flex-wrap items-center justify-center gap-2.5">
          <a
            href="/search"
            class="inline-flex items-center gap-2 rounded-lg bg-emerald-700 px-4 py-2.5 text-xs font-semibold text-white shadow-2xs transition-colors duration-150 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500"
          >
            <span>🔍 Search Free Tools</span>
          </a>
          <a
            href="/category/student-perks"
            class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-xs font-medium text-zinc-700 shadow-2xs transition-colors duration-150 hover:border-zinc-300 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:bg-zinc-850"
          >
            <span>🎓 Student Perks</span>
          </a>
        </div>

      </div>

      <!-- Clean Category Filter Chips -->
      <div class="mt-10 pt-6 border-t border-zinc-100 dark:border-zinc-900">
        <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
          {siteConfig.categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200/80 bg-zinc-50/60 px-3 py-1.5 text-xs font-medium text-zinc-600 transition-colors duration-150 hover:border-zinc-300 hover:bg-white hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-900/60 dark:text-zinc-400 dark:hover:border-zinc-700 dark:hover:bg-zinc-850 dark:hover:text-zinc-200"
            >
              <span>{cat.icon}</span>
              <span>{cat.name}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Main Content Container -->
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    
    <!-- Top Ad Placement (Reserved Banner Slot) -->
    <AdBanner slotType="below-title" className="mb-8" />

    <!-- Articles Section Header -->
    <div class="flex items-center justify-between pb-4 border-b border-zinc-200/70 dark:border-zinc-800/70">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-2xl">
          Latest Fresh Articles
        </h2>
        <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">
          Curated guides and verified student resources.
        </p>
      </div>
      <a
        href="/search"
        class="text-xs font-medium text-emerald-700 hover:underline dark:text-emerald-400"
      >
        View all →
      </a>
    </div>

    <!-- Articles Grid -->
    <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
      {featuredPost && (
        <ArticleCard
          title={featuredPost.data.title}
          description={featuredPost.data.description}
          pubDate={new Date(featuredPost.data.pubDate)}
          category={featuredPost.data.category}
          tags={featuredPost.data.tags}
          slug={featuredPost.id.replace(/\.(md|mdx)$/, '')}
          rawContent={featuredPost.body}
          featured={true}
        />
      )}

      {regularPosts.map((post) => (
        <ArticleCard
          title={post.data.title}
          description={post.data.description}
          pubDate={new Date(post.data.pubDate)}
          category={post.data.category}
          tags={post.data.tags}
          slug={post.id.replace(/\.(md|mdx)$/, '')}
          rawContent={post.body}
          featured={false}
        />
      ))}
    </div>

    <!-- Clean Newsletter Box -->
    <div class="mt-14">
      <NewsletterBox />
    </div>

    <!-- Mid-feed Reserved Ad Slot -->
    <div class="mt-10">
      <AdBanner slotType="footer" />
    </div>

  </div>
</BaseLayout>
