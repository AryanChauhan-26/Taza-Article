---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { getCollection } from 'astro:content';
import { getCategorySlug } from '../utils/slugify';

const allPosts = await getCollection('blog', ({ id }) => !id.startsWith('_'));

// Calculate count per category
const categoryCounts = allPosts.reduce((acc, post) => {
  const slug = getCategorySlug(post.data.category);
  acc[slug] = (acc[slug] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
---

<BaseLayout
  title="All Categories"
  description="Explore all curated topic categories on Taza Article: Developer Tools, Cloud & Databases, Student Perks, and Learning Roadmaps."
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
        Index
      </span>
      <h1 class="mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Explore Topics & Categories
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
        Browse our collection of zero-cost developer resources, student packs, and engineering project guides.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {siteConfig.categories.map((cat) => {
        const count = categoryCounts[cat.slug] || 0;
        return (
          <a
            href={`/category/${cat.slug}`}
            class="group relative flex flex-col justify-between rounded-xl border border-zinc-200/80 bg-white p-5 shadow-2xs transition-colors duration-150 hover:border-zinc-300 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="text-2xl">{cat.icon}</span>
                <span class="rounded bg-zinc-100 px-2 py-0.5 text-[11px] font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                  {count} {count === 1 ? 'post' : 'posts'}
                </span>
              </div>
              <h2 class="mt-3 text-base font-bold text-zinc-900 group-hover:text-emerald-700 transition-colors duration-150 dark:text-zinc-100 dark:group-hover:text-emerald-400">
                {cat.name}
              </h2>
              <p class="mt-1 text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">
                {cat.description}
              </p>
            </div>
            
            <div class="mt-4 flex items-center text-xs font-medium text-emerald-700 dark:text-emerald-400">
              <span>View archive</span>
              <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
