---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);

const shareLinks = [
  {
    name: 'WhatsApp',
    url: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    icon: '💬',
    hoverClass: 'hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400',
  },
  {
    name: 'X (Twitter)',
    url: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
    icon: '𝕏',
    hoverClass: 'hover:border-zinc-400 hover:text-zinc-900 dark:hover:text-white',
  },
  {
    name: 'LinkedIn',
    url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: 'in',
    hoverClass: 'hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400',
  },
];
---

<div class="my-6 rounded-xl border border-zinc-200/80 bg-white p-3.5 shadow-2xs dark:border-zinc-800 dark:bg-zinc-900">
  <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-xs font-medium text-zinc-700 dark:text-zinc-300">
      Share this guide:
    </div>

    <div class="flex flex-wrap items-center gap-1.5" id="share-buttons-container">
      {shareLinks.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex items-center gap-1 rounded-md border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-600 shadow-2xs transition-colors duration-150 dark:border-zinc-800 dark:bg-zinc-850 dark:text-zinc-300 ${item.hoverClass}`}
          aria-label={`Share on ${item.name}`}
        >
          <span class="font-bold text-[11px]">{item.icon}</span>
          <span>{item.name}</span>
        </a>
      ))}

      <button
        type="button"
        id="copy-link-btn"
        data-url={url}
        class="inline-flex items-center gap-1 rounded-md border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-600 shadow-2xs transition-colors duration-150 hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-800 dark:bg-zinc-850 dark:text-zinc-300 dark:hover:border-zinc-700 dark:hover:text-white"
        aria-label="Copy article link"
      >
        <span id="copy-icon" class="text-xs">🔗</span>
        <span id="copy-text">Copy</span>
      </button>
    </div>
  </div>
</div>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const textEl = document.getElementById('copy-text');
        const iconEl = document.getElementById('copy-icon');
        if (textEl && iconEl) {
          textEl.textContent = 'Copied!';
          iconEl.textContent = '✓';
          setTimeout(() => {
            textEl.textContent = 'Copy';
            iconEl.textContent = '🔗';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy URL', err);
      }
    });
  }
</script>
